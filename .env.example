# Set this to the website that will call the failure API.
# Leave unset to allow requests from any origin during development.
ALLOWED_ORIGIN=https://your-website.com

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/tpa_management?retryWrites=true&w=majority
MONGODB_DB=tpa_management

# Use a long random value in production.
AUTH_SECRET=replace-with-at-least-32-random-bytes
INITIAL_ADMIN_PASSWORD=replace-with-initial-admin-password
INITIAL_VIEWER_PASSWORD=replace-with-initial-viewer-password

# Optional but strongly recommended when this API is publicly accessible.
# Send the same value in the X-API-Key request header.
STATUS_API_KEY=replace-with-a-long-random-secret
